{
  "name": "live2d-desktop-assistant",
  "version": "1.0.3",
  "description": "A transparent Live2D-style desktop companion for ChatGPT Desktop.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "pack:portable": "electron-builder --win portable --publish never",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "verify": "node scripts/run-verify.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "pixi.js": "^6.5.10",
    "pixi-live2d-display": "^0.4.0"
  },
  "build": {
    "compression": "store",
    "appId": "local.codex.live2d.assistant",
    "productName": "Live2D Desktop Assistant",
    "files": ["main.js", "preload.js", "src/**/*", "data/**/*", "runtime/**/*", "miku/**/*", "scripts/verify-electron.cjs"],
    "directories": { "output": "dist/1.0.3" },
    "win": {
      "target": "nsis"
    }
  }
}
